[
  {
    "apiVersion": "v1",
    "kind": "ServiceAccount",
    "metadata": {
      "name": "kiki-kam-auth",
      "namespace": "kam-system"
    }
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "Role",
    "metadata": {
      "name": "kiki-kam-auth",
      "namespace": "kam-system"
    },
    "rules": [
      {
        "apiGroups": [
          ""
        ],
        "resources": [
          "secrets"
        ],
        "resourceNames": [
          "kiki-kam-identities"
        ],
        "verbs": [
          "get",
          "update"
        ]
      }
    ]
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "RoleBinding",
    "metadata": {
      "name": "kiki-kam-auth",
      "namespace": "kam-system"
    },
    "roleRef": {
      "apiGroup": "rbac.authorization.k8s.io",
      "kind": "Role",
      "name": "kiki-kam-auth"
    },
    "subjects": [
      {
        "kind": "ServiceAccount",
        "name": "kiki-kam-auth",
        "namespace": "kam-system"
      }
    ]
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRole",
    "metadata": {
      "name": "kiki-kam-grant-admin"
    },
    "rules": [
      {
        "apiGroups": [
          "access.kam.dustbox.kr"
        ],
        "resources": [
          "kamaccessgrants"
        ],
        "verbs": [
          "get",
          "list",
          "create",
          "update",
          "patch",
          "delete"
        ]
      }
    ]
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRoleBinding",
    "metadata": {
      "name": "kiki-kam-grant-admin"
    },
    "roleRef": {
      "apiGroup": "rbac.authorization.k8s.io",
      "kind": "ClusterRole",
      "name": "kiki-kam-grant-admin"
    },
    "subjects": [
      {
        "kind": "Group",
        "name": "kiki-kam:account-admins",
        "apiGroup": "rbac.authorization.k8s.io"
      }
    ]
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRole",
    "metadata": {
      "name": "kiki-kam-namespace-discovery"
    },
    "rules": [
      {
        "apiGroups": [
          ""
        ],
        "resources": [
          "namespaces"
        ],
        "verbs": [
          "get",
          "list"
        ]
      }
    ]
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRoleBinding",
    "metadata": {
      "name": "kiki-kam-namespace-discovery"
    },
    "roleRef": {
      "apiGroup": "rbac.authorization.k8s.io",
      "kind": "ClusterRole",
      "name": "kiki-kam-namespace-discovery"
    },
    "subjects": [
      {
        "kind": "Group",
        "name": "kiki-kam:users",
        "apiGroup": "rbac.authorization.k8s.io"
      }
    ]
  },
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "kiki-kam-auth",
      "namespace": "kam-system"
    },
    "spec": {
      "selector": {
        "app": "kiki-kam-auth"
      },
      "ports": [
        {
          "name": "https",
          "port": 443,
          "targetPort": 8443
        }
      ]
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "kiki-kam-auth",
      "namespace": "kam-system"
    },
    "spec": {
      "replicas": 2,
      "selector": {
        "matchLabels": {
          "app": "kiki-kam-auth"
        }
      },
      "strategy": {
        "type": "RollingUpdate",
        "rollingUpdate": {
          "maxSurge": 0,
          "maxUnavailable": 1
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "kiki-kam-auth"
          }
        },
        "spec": {
          "serviceAccountName": "kiki-kam-auth",
          "terminationGracePeriodSeconds": 20,
          "securityContext": {
            "runAsNonRoot": true,
            "runAsUser": 65532,
            "fsGroup": 65532,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "topologySpreadConstraints": [
            {
              "maxSkew": 1,
              "topologyKey": "kubernetes.io/hostname",
              "whenUnsatisfiable": "DoNotSchedule",
              "labelSelector": {
                "matchLabels": {
                  "app": "kiki-kam-auth"
                }
              }
            }
          ],
          "containers": [
            {
              "name": "auth",
              "image": "__AUTH_IMAGE__",
              "args": [
                "serve",
                "--audience",
                "__API_AUDIENCE__"
              ],
              "ports": [
                {
                  "containerPort": 8443
                }
              ],
              "securityContext": {
                "readOnlyRootFilesystem": true,
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              },
              "resources": {
                "requests": {
                  "cpu": "100m",
                  "memory": "64Mi"
                },
                "limits": {
                  "cpu": "1",
                  "memory": "256Mi"
                }
              },
              "readinessProbe": {
                "httpGet": {
                  "scheme": "HTTPS",
                  "path": "/readyz",
                  "port": 8443
                }
              },
              "livenessProbe": {
                "httpGet": {
                  "scheme": "HTTPS",
                  "path": "/healthz",
                  "port": 8443
                }
              },
              "volumeMounts": [
                {
                  "name": "tls",
                  "mountPath": "/tls",
                  "readOnly": true
                },
                {
                  "name": "webhook",
                  "mountPath": "/webhook",
                  "readOnly": true
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "tls",
              "secret": {
                "secretName": "kiki-kam-tls",
                "defaultMode": 288
              }
            },
            {
              "name": "webhook",
              "configMap": {
                "name": "kiki-kam-webhook-ca"
              }
            }
          ]
        }
      }
    }
  },
  {
    "apiVersion": "policy/v1",
    "kind": "PodDisruptionBudget",
    "metadata": {
      "name": "kiki-kam-auth",
      "namespace": "kam-system"
    },
    "spec": {
      "minAvailable": 1,
      "selector": {
        "matchLabels": {
          "app": "kiki-kam-auth"
        }
      }
    }
  }
]

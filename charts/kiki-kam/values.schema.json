{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "local": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowUnpinnedImages": {
          "type": "boolean"
        }
      },
      "required": [
        "allowUnpinnedImages"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "imagePullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort"
              ]
            },
            "nodePort": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32767
            }
          },
          "required": [
            "type",
            "nodePort"
          ]
        }
      },
      "required": [
        "enabled",
        "image",
        "audience",
        "replicas",
        "imagePullPolicy",
        "service"
      ]
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "imagePullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "targets": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
              },
              "profiles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "view",
                    "edit",
                    "admin"
                  ]
                }
              }
            },
            "required": [
              "namespace",
              "profiles"
            ]
          }
        }
      },
      "required": [
        "image",
        "replicas",
        "imagePullPolicy",
        "targets"
      ]
    }
  },
  "required": [
    "local",
    "imagePullSecrets",
    "auth",
    "controller"
  ],
  "$schema": "https://json-schema.org/draft-07/schema#"
}
